# Local-only development values. Never use these credentials outside a disposable local database.
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel-local-only

# The API reads this separately from Compose. Set it in the current PowerShell session before running.
SENTINEL_DATABASE_URL=postgres://sentinel:sentinel-local-only@127.0.0.1:5435/sentinel?sslmode=disable
SENTINEL_HTTP_ADDR=127.0.0.1:8080
