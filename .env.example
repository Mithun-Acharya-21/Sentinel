# Local-only development values. Never use these credentials outside a disposable local database.
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel-local-only

# Core API settings
SENTINEL_DATABASE_URL=postgres://sentinel:sentinel-local-only@127.0.0.1:5435/sentinel?sslmode=disable
SENTINEL_HTTP_ADDR=127.0.0.1:8080

# Optional rate limiting (defaults: enabled=true, rps=10, burst=20)
# SENTINEL_RATE_LIMIT_ENABLED=true
# SENTINEL_RATE_LIMIT_RPS=10
# SENTINEL_RATE_LIMIT_BURST=20
# SENTINEL_PREAUTH_RATE_LIMIT_RPS=10
# SENTINEL_PREAUTH_RATE_LIMIT_BURST=20
# SENTINEL_RATE_LIMIT_TRUSTED_PROXIES=

# Optional background worker pool (defaults: count=2, poll=500ms, lease=30s)
# SENTINEL_WORKER_COUNT=2
# SENTINEL_WORKER_POLL_INTERVAL=500ms
# SENTINEL_WORKER_LEASE_DURATION=30s

# Optional LLM triage provider (when unset, workers record idempotent triage placeholders)
# Never commit real API keys.
# SENTINEL_LLM_API_KEY=demo-local-key
# SENTINEL_LLM_ENDPOINT=http://127.0.0.1:18081/v1/chat/completions
# SENTINEL_LLM_MODEL=gpt-4o-mini
# SENTINEL_LLM_TIMEOUT=30s
